<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">


<mapper namespace="com.example.spring_boot_mode.model.dao.LoginDao">
    <resultMap id="LoginMap" type="com.example.spring_boot_mode.model.entity.SysUser">
        <!--    property:实体类中       column:数据库中字段          -->
        <result property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="password" column="password"/>
        <result property="nickName" column="nickName"/>
        <result property="email" column="email"/>
        <result property="phone" column="phone"/>
        <result property="birthday" column="birthday"/>
        <result property="gender" column="gender"/>
        <result property="avatar" column="avatar"/>
        <result property="theme" column="theme"/>
        <result property="captchaEnabled" column="captchaEnabled"/>
        <result property="createTime" column="createTime"/>
        <result property="updateTime" column="updateTime"/>
        <result property="onlineStatus" column="onlineStatus"/>
    </resultMap>
    <sql id="selectLogin">
        select id,
               username,
               password,
               nickName,
               email,
               phone,
               birthday,
               gender,
               avatar,
               theme,
               captchaEnabled,
               createTime,
               updateTime,
               onlineStatus
               from  sys_user
    </sql>

    <select id="tologin" resultMap="LoginMap">
        <include refid="selectLogin"/>
        where  username = #{username}
    </select>
    <insert id="tosignUp">
        insert into sys_user
        (
        id,
        username,
        password,
        nickName,
        email,
        createTime
        )values
        (
        #{id},
        #{username},
        #{password},
        #{nickName},
        #{email},
        #{createTime}
        )
    </insert>
    <select id="tocheckname" resultType="int">
        select count(username) from sys_user where username = #{username}
    </select>

    <!-- 根据ID查询用户 -->
    <select id="selectById" parameterType="java.lang.String" resultMap="LoginMap">
        <include refid="selectLogin"/>
        where id = #{id}
    </select>

    <!-- 更新用户基本信息 -->
    <update id="updateInfo" parameterType="com.example.spring_boot_mode.model.entity.SysUser">
        UPDATE sys_user
        <set>
            <if test="nickName != null">nickName = #{nickName},</if>
            <if test="email != null">email = #{email},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="birthday != null">birthday = #{birthday},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="theme != null">theme = #{theme},</if>
            <if test="captchaEnabled != null">captchaEnabled = #{captchaEnabled},</if>
            <if test="updateTime != null">updateTime = #{updateTime},</if>
            <if test="onlineStatus != null">onlineStatus = #{onlineStatus},</if>
        </set>
        WHERE id = #{id}
    </update>

    <!-- 更新密码 -->
    <update id="updatePassword">
        UPDATE sys_user SET password = #{newPassword}, updateTime = #{updateTime}
        WHERE id = #{id} AND password = #{oldPassword}
    </update>

    <!-- 查询所有用户（用于发布通知时选择接收者） -->
    <select id="selectAllUsersForNotification" resultType="map">
        SELECT id as id,
               username as username,
               nickName as nickname,
               avatar as avatar
        FROM sys_user
    </select>

</mapper>
